rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasUserDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return hasUserDoc()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false;
    }
    function controlExists() {
      return exists(/databases/$(database)/documents/appControl/main);
    }
    function controlData() {
      return get(/databases/$(database)/documents/appControl/main).data;
    }
    function appActive() {
      return !controlExists() || controlData().get('active', true) == true;
    }
    function publicCan(field) {
      return signedIn() && appActive() && controlExists()
        && controlData().get(field, false) == true;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'operator'];
      allow delete: if false;
    }

    match /appControl/{controlId} {
      allow read: if signedIn();
      allow create: if isAdmin() && controlId == 'main';
      allow update: if isAdmin() || (
        signedIn() && appActive() && controlId == 'main'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['sheetNumbers', 'updatedAt', 'updatedBy'])
        && (
          (request.resource.data.sheetNumbers.size() > resource.data.sheetNumbers.size()
            && publicCan('allowAddSheet'))
          ||
          (request.resource.data.sheetNumbers.size() < resource.data.sheetNumbers.size()
            && publicCan('allowDeleteSheet'))
        )
      );
      allow delete: if false;
    }

    match /stockItems/_meta {
      allow read: if signedIn() && (isAdmin() || appActive());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /stockItems/{itemId} {
      allow read: if signedIn() && (isAdmin() || appActive());
      allow create: if itemId != '_meta' && (
        isAdmin() || publicCan('allowAddStock')
      );
      allow update: if itemId != '_meta' && (
        isAdmin() || publicCan('allowEditStock')
      );
      allow delete: if itemId != '_meta' && (
        isAdmin()
        || publicCan('allowDeleteStock')
        || (publicCan('allowDeleteSheet')
          && resource.data.sheet is number
          && !(resource.data.sheet in controlData().get('sheetNumbers', [1, 2, 3])))
      );
    }
  }
}
