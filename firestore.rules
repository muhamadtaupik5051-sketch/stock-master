rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aplikasi memakai Firebase Anonymous Auth otomatis.
    // Siapa pun yang membuka aplikasi dapat membaca, menambah, dan mengubah stok.
    // Penghapusan juga diizinkan pada versi awal; hapus izin ini jika ingin proteksi ekstra.
    match /stockItems/{itemId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}